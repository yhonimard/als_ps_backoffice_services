generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  username       String          @unique
  password       String
  name           String?
  role           Role
  product        Product[]
  stockMovements StockMovement[]
}

model Product {
  id          String   @id @default(uuid())
  sku         String?
  name        String
  sellPrice   Int
  isActive    Boolean  @default(true)
  categoryId  String
  createdById String
  category    Category @relation(fields: [categoryId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model Category {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model Purchase {
  id    String         @id @default(uuid())
  total Int
  items PurchaseItem[]
}

model ingredient {
  id             String          @id @default(uuid())
  name           String
  unit           String
  stock          Decimal
  averagePrice   Decimal
  purchaseItem   PurchaseItem[]
  stockMovements StockMovement[]
}

model PurchaseItem {
  id            String     @id @default(uuid())
  invoiceNo     String?
  total         Decimal    @db.Decimal(12, 2)
  purchaseId    String
  ingredientdId String
  ingredient    ingredient @relation(fields: [ingredientdId], references: [id])
  purchase      Purchase   @relation(fields: [purchaseId], references: [id])
}

model StockMovement {
  id           String       @id @default(uuid())
  createdById  String
  ingredientId String
  type         movementType
  qty          Decimal      @db.Decimal(12, 2)
  notes        String?
  createdBy    User         @relation(fields: [createdById], references: [id])
  ingredient   ingredient   @relation(fields: [ingredientId], references: [id])
}

enum Role {
  SUPERUSER
  ADMIN
  MANAGER
  CASHIER
}

enum movementType {
  PURCHASE
  SALE
  OPNAME
  ADJUSTMENT
}
