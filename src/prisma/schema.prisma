generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  username       String          @unique
  password       String
  name           String?
  role           Role
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  product        Product[]
  stockMovements StockMovement[]
}

model Product {
  id          String   @id @default(uuid())
  sku         String?
  name        String
  sellPrice   Int
  isActive    Boolean  @default(true)
  categoryId  String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Purchase {
  id        String         @id @default(uuid())
  total     Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     PurchaseItem[]
}

model ingredient {
  id             String          @id @default(uuid())
  name           String
  unit           String
  stock          Decimal
  averagePrice   Decimal
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseItem   PurchaseItem[]
  stockMovements StockMovement[]
}

model PurchaseItem {
  id            String     @id @default(uuid())
  invoiceNo     String?
  total         Decimal    @db.Decimal(12, 2)
  purchaseId    String
  ingredientdId String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  ingredient    ingredient @relation(fields: [ingredientdId], references: [id])
  purchase      Purchase   @relation(fields: [purchaseId], references: [id])
}

model StockMovement {
  id           String       @id @default(uuid())
  createdById  String
  ingredientId String
  type         movementType
  qty          Decimal      @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    User         @relation(fields: [createdById], references: [id])
  ingredient   ingredient   @relation(fields: [ingredientId], references: [id])
}

enum Role {
  SUPERUSER
  ADMIN
  MANAGER
  CASHIER
}

enum movementType {
  PURCHASE
  SALE
  OPNAME
  ADJUSTMENT
}
